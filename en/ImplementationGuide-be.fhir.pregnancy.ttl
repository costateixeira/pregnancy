<https://www.ehealth.fgov.be/standards/fhir/pregnancy/ImplementationGuide/be.fhir.pregnancy> a fhir:ImplementationGuide ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "be.fhir.pregnancy"] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide be.fhir.pregnancy</b></p><a name=\"be.fhir.pregnancy\"> </a><a name=\"hcbe.fhir.pregnancy\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: en</p></div><h2>BeFhirPregnancy</h2><p>The official URL for this implementation guide is: </p><pre>https://www.ehealth.fgov.be/standards/fhir/pregnancy/ImplementationGuide/be.fhir.pregnancy</pre><div><p>Belgian FHIR Implementation Guide for pregnancy data. Initial scope: a small set of pregnancy-status data — pregnancy confirmation, expected due date, expected number of children, and pregnancy duration. Vitalink FHIR and MAGDA are one implementation, collecting this data from EMR/hospital systems and making it available to government agencies (notably VUTG for Groeipakket entitlement), to citizen platforms (mijngezondheid.be, mijnburgerprofiel.be) and to caregivers. The IG is designed to grow incrementally, with administrative and clinical pregnancy data added by other stakeholders and projects (eBirth, Born in Belgium, Zoet Zwanger, PALS, AZ Turnhout moeder/kind boekje, etc.) over time.</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "https://www.ehealth.fgov.be/standards/fhir/pregnancy/ImplementationGuide/be.fhir.pregnancy"] ;
  fhir:ImplementationGuide.version [ fhir:value "0.1.0"] ;
  fhir:ImplementationGuide.name [ fhir:value "BeFhirPregnancy"] ;
  fhir:ImplementationGuide.title [ fhir:value "Belgian Pregnancy Implementation Guide"] ;
  fhir:ImplementationGuide.status [ fhir:value "draft"] ;
  fhir:ImplementationGuide.date [ fhir:value "2026-07-09T11:32:30+00:00"^^xsd:dateTime] ;
  fhir:ImplementationGuide.publisher [ fhir:value "Departement Zorg"] ;
  fhir:ImplementationGuide.contact [
     fhir:index -1 ;
     fhir:ContactDetail.name [ fhir:value "Departement Zorg" ] ;
     fhir:ContactDetail.telecom [
       fhir:index -1 ;
       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "https://www.departementzorg.be" ]
     ]
  ] ;
  fhir:ImplementationGuide.description [ fhir:value "Belgian FHIR Implementation Guide for pregnancy data. Initial scope: a small set of pregnancy-status data — pregnancy confirmation, expected due date, expected number of children, and pregnancy duration. Vitalink FHIR and MAGDA are one implementation, collecting this data from EMR/hospital systems and making it available to government agencies (notably VUTG for Groeipakket entitlement), to citizen platforms (mijngezondheid.be, mijnburgerprofiel.be) and to caregivers. The IG is designed to grow incrementally, with administrative and clinical pregnancy data added by other stakeholders and projects (eBirth, Born in Belgium, Zoet Zwanger, PALS, AZ Turnhout moeder/kind boekje, etc.) over time."] ;
