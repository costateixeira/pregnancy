       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Patient used by all pregnancy-status examples." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
