# - resource -------------------------------------------------------------------

<https://www.ehealth.fgov.be/standards/fhir/pregnancy/Practitioner/ex-gynaecologist> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ex-gynaecologist"] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Practitioner ex-gynaecologist</b></p><a name=\"ex-gynaecologist\"> </a><a name=\"hcex-gynaecologist\"> </a><p><b>name</b>: Anke De Vries </p></div>"
  ] ;
  fhir:Practitioner.name [
     fhir:index -1 ;
     fhir:HumanName.family [ fhir:value "De Vries" ] ;
     fhir:HumanName.given [
       fhir:value "Anke" ;
       fhir:index -1
     ]
  ] .

