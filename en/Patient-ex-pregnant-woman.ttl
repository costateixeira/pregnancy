# - resource -------------------------------------------------------------------

<https://www.ehealth.fgov.be/standards/fhir/pregnancy/Patient/ex-pregnant-woman> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ex-pregnant-woman"] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient ex-pregnant-woman</b></p><a name=\"ex-pregnant-woman\"> </a><a name=\"hcex-pregnant-woman\"> </a><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Jana Peeters  Female, DoB Unknown</p><hr/></div>"
  ] ;
  fhir:Patient.name [
     fhir:index -1 ;
     fhir:HumanName.family [ fhir:value "Peeters" ] ;
     fhir:HumanName.given [
       fhir:value "Jana" ;
       fhir:index -1
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "female"] .

